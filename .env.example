# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/copy_trade
DATABASE_POOL_SIZE=10

# Queue
QUEUE_URL=redis://localhost:6379
QUEUE_PREFIX=copy-trade
QUEUE_CONCURRENCY=5

# Solana provider
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT_MS=10000
SOLANA_RPC_MAX_RETRIES=3

# Authentication
AUTH_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400

# Security
# Set these through a secret manager or local untracked environment file.
SESSION_SECRET=replace-with-a-long-random-development-secret

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
